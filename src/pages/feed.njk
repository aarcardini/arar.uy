---
permalink: /feed.xml
eleventyExcludeFromCollections: true
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.shortName }} — Cuaderno de notas</title>
    <link>{{ site.url }}/cuaderno/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    <description>Un paseo por mis conexiones sinápticas. Notas sobre arquitectura, diseño y experiencia humana.</description>
    <language>es</language>
    {%- for post in collections.posts | limit(20) %}
    <item>
      <title>{{ post.data.title | xmlEscape }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.date.toUTCString() }}</pubDate>
      <description>{{ post.data.excerpt | xmlEscape }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
