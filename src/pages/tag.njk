---
layout: page
pagination:
  data: tagList
  size: 1
  alias: term
permalink: "/tag/{{ term.slug }}/"
navActive: /cuaderno/
eleventyComputed:
  title: "{{ term.name }}"
  seoTitle: "{{ term.name }} - Cuaderno de notas - Estudio ARAR."
  description: "Notas del Cuaderno de Estudio ARAR sobre {{ term.name }}."
---
<section class="archive container">
  <header class="archive__header">
    <p class="label">Etiqueta</p>
    <h1 class="display">{{ term.name }}</h1>
    <p class="archive__back"><a href="/cuaderno/">{% include "icons/arrow-left.svg" %} Volver al Cuaderno</a></p>
  </header>
  <div class="cards">
    {%- set cardHeading = "h2" %}
    {%- for post in collections.posts | inTag(term.slug) %}
    {% include "partials/post-card.njk" %}
    {%- endfor %}
  </div>
</section>
