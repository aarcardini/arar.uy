<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = seoTitle if seoTitle else (title ~ " - " ~ site.name if title else site.title) %}
  {%- set pageDescription = description if description else site.description %}
  {%- set pageImage = image if image else site.ogImage %}
  {%- set canonical = site.url ~ page.url %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {%- if env.noindex %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:locale" content="es_ES">
  <meta property="og:type" content="{{ 'article' if layout == 'post' else 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site.url ~ pageImage }}">
  {%- if layout == 'post' %}
  <meta property="article:published_time" content="{{ page.date | dateISO }}">
  <meta property="article:author" content="{{ site.author }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ site.url ~ pageImage }}">
  <link rel="icon" href="/assets/favicon-32x32.png" sizes="32x32">
  <link rel="icon" href="/assets/favicon-192x192.png" sizes="192x192">
  <link rel="apple-touch-icon" href="/assets/favicon-180x180.png">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} — Cuaderno de notas" href="/feed.xml">
  <link rel="preload" href="/assets/fonts/lora-700-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/fonts/fonts.css">
  <link rel="stylesheet" href="/assets/css/style.css">
  {%- set isPost = (layout == 'post') %}
  {%- set published = page.date | dateISO %}
  {%- set updated = (modified | dateISO) if modified else published %}
  {%- set org = {"@type": "ArchitectureFirm", "@id": site.url ~ "/#organization", "name": site.name, "url": site.url ~ "/", "email": site.email, "telephone": "+59891428436", "logo": site.url ~ "/assets/favicon-192x192.png", "image": site.url ~ site.ogImage, "address": {"@type": "PostalAddress", "addressLocality": "Montevideo", "addressCountry": "UY"}, "sameAs": [site.social.facebook, site.social.linkedin, site.social.instagram], "founder": [{"@type": "Person", "name": "Alejandro Arcardini Ravera"}, {"@type": "Person", "name": "Karen Johann Alvarez"}]} %}
  {%- set crumbs = [{"@type": "ListItem", "position": 1, "name": "Inicio", "item": site.url ~ "/"}] %}
  {%- if isPost %}
    {%- set catNames = [] %}{% for c in (categories or []) %}{% set catNames = (catNames.push(c | termName(categoryList)), catNames) %}{% endfor %}
    {%- set tagNames = [] %}{% for t in (tags or []) %}{% set tagNames = (tagNames.push(t | termName(tagList)), tagNames) %}{% endfor %}
    {%- set crumbs = crumbs.concat([{"@type": "ListItem", "position": 2, "name": "Cuaderno de notas", "item": site.url ~ "/cuaderno/"}, {"@type": "ListItem", "position": 3, "name": title}]) %}
    {%- set main = {"@type": "BlogPosting", "@id": canonical ~ "#article", "mainEntityOfPage": canonical, "url": canonical, "headline": title, "description": pageDescription, "image": site.url ~ pageImage, "datePublished": published, "dateModified": updated, "inLanguage": "es", "articleSection": catNames | join(", "), "keywords": tagNames | join(", "), "author": {"@type": "Person", "name": site.author, "url": site.url ~ "/nosotros_como_estudio_de_arquitectura/"}, "publisher": org} %}
  {%- else %}
    {%- if page.url != "/" %}{% set crumbs = crumbs.concat([{"@type": "ListItem", "position": 2, "name": title}]) %}{% endif %}
    {%- set main = {"@type": "WebPage", "@id": canonical, "url": canonical, "name": pageTitle, "description": pageDescription, "inLanguage": "es", "isPartOf": {"@type": "WebSite", "name": site.name, "url": site.url ~ "/"}, "about": org} %}
  {%- endif %}
  {%- set graph = [main] %}
  {%- if crumbs.length > 1 %}{% set graph = graph.concat([{"@type": "BreadcrumbList", "itemListElement": crumbs}]) %}{% endif %}
  <script type="application/ld+json">{{ {"@context": "https://schema.org", "@graph": graph} | jsonify | safe }}</script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#contenido">Ir al contenido</a>
  {%- if not canvas %}
  {% include "partials/header.njk" %}
  {%- endif %}
  <main id="contenido">
    {{ content | safe }}
  </main>
  {%- if not canvas %}
  {% include "partials/footer.njk" %}
  {%- endif %}
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
