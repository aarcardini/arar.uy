{%- set cardThemes = post.data.categories | themesOf(temas) %}
<article class="card" data-cats="{{ post.data.categories | join(' ') }}" data-search="{{ post.data.title }} {{ post.data.excerpt }}{% for t in cardThemes %} {{ t.name }}{% endfor %}">
  <a class="card__media" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
    {%- if post.data.image %}
    <img src="{{ post.data.image }}" alt="" loading="lazy" decoding="async"{% if post.data.imageWidth %} width="{{ post.data.imageWidth }}" height="{{ post.data.imageHeight }}"{% endif %}>
    {%- endif %}
  </a>
  <div class="card__body">
    {%- set mainT = post.data.categories | mainTheme(temas) %}
    {%- if mainT %}<p class="card__theme">{{ mainT.name }}</p>{% endif %}
    <{{ cardHeading or "h3" }} class="card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></{{ cardHeading or "h3" }}>
    <p class="card__date"><time datetime="{{ post.date | dateShort }}">{{ post.date | dateEs }}</time> · {{ (post.rawInput or post.templateContent) | readingTime }} min de lectura</p>
    <p class="card__excerpt">{{ post.data.excerpt }}</p>
  </div>
</article>
