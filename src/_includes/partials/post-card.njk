<article class="card" data-cats="{{ post.data.categories | join(' ') }}">
  <a class="card__media" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
    {%- if post.data.image %}
    <img src="{{ post.data.image }}" alt="" loading="lazy" decoding="async"{% if post.data.imageWidth %} width="{{ post.data.imageWidth }}" height="{{ post.data.imageHeight }}"{% endif %}>
    {%- endif %}
  </a>
  <div class="card__body">
    <h3 class="card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <p class="card__date"><time datetime="{{ post.date | dateShort }}">{{ post.date | dateEs }}</time></p>
    <p class="card__excerpt">{{ post.data.excerpt }}</p>
    <a class="card__more" href="{{ post.url }}">Leer más »</a>
  </div>
</article>
