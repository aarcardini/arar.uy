{%- if not hideCta %}
{% include "partials/cta.njk" %}
{%- endif %}
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-col--brand">
        <p class="footer-brand">{{ site.name }}</p>
        <p>{{ site.tagline }}</p>
      </div>
      <div class="footer-col">
        <h2 class="footer-title">Legal</h2>
        <ul class="footer-links">
          {%- for item in site.legal %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <div class="footer-col footer-col--book">
        <a href="{{ site.book.url }}" aria-label="{{ site.book.title }}"><img src="{{ site.book.cover }}" alt="{{ site.book.coverAlt }}" width="862" height="1080" loading="lazy" decoding="async"></a>
      </div>
      <div class="footer-col">
        <h2 class="footer-title">Contacto</h2>
        <ul class="icon-list">
          <li>{% include "icons/location.svg" %}<span>{{ site.location }}</span></li>
          <li>{% include "icons/mail.svg" %}<a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li>{% include "icons/whatsapp.svg" %}<a href="{{ site.whatsapp }}?text={{ site.whatsappMessage | urlencode }}" target="_blank" rel="noopener">{{ site.phoneDisplay }}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-copy">© {{ env.buildYear }} {{ site.name }} Todos los derechos reservados.</p>
      <ul class="social" aria-label="Redes sociales">
        <li><a href="{{ site.social.facebook }}" target="_blank" rel="noopener nofollow" aria-label="Facebook">{% include "icons/facebook.svg" %}</a></li>
        <li><a href="{{ site.social.linkedin }}" target="_blank" rel="noopener nofollow" aria-label="LinkedIn">{% include "icons/linkedin.svg" %}</a></li>
        <li><a href="{{ site.social.instagram }}" target="_blank" rel="noopener nofollow" aria-label="Instagram">{% include "icons/instagram.svg" %}</a></li>
      </ul>
    </div>
  </div>
</footer>
